[Unit]
Description=Module Health Index — воркер прогонів %i
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/modidx
Environment=ROOT=/srv/modidx
# Лапки — з тієї ж причини, що й у modidx-harvest.service: без них systemd
# бачив SERIES=17.0. Тут це не проявилось лише тому, що claim() у runner.py
# бере серію з голови черги й змінну не читає; лишати пастку однаково не варто.
Environment="SERIES=17.0 18.0 19.0"
# BATCH=8 для першого масового проходу, BATCH=1 для точних перевірок
Environment=BATCH=8
Environment=RUN_MEM=2g
Environment=RUN_TIMEOUT=420
ExecStart=/usr/bin/python3 /srv/modidx/indexer/runner.py
Restart=always
RestartSec=15
# межа для самого оркестратора, не для контейнерів Odoo
MemoryMax=400M
Nice=5
StandardOutput=append:/srv/modidx/var/logs/runner-%i.log
StandardError=append:/srv/modidx/var/logs/runner-%i.log

[Install]
WantedBy=multi-user.target
