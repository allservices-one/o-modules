# ─────────────────────────────────────────────────────────────────────────────
# Апекс allservices.one — Module Health Index.
#
# Наявного ресурсу на апексі БІЛЬШЕ НЕМАЄ. Odoo-каталог постачальників послуг
# виведено з експлуатації 18.08.2026 18:53 UTC і заархівовано в
# /root/archive-allservices-2026-08-18. Порти 80/443/5432 вільні, веб-сервера
# в системі немає взагалі. Переносити нічого, субдомен не потрібен.
#
# ЄДИНА ПЕРЕДУМОВА ЗАПУСКУ — AAAA-запис:
#   AAAA апекса      = 2001:41d0:203:dee4:5:39:10:93  (паркування Imena.UA, OVH)
#   IPv6 цього сервера = 2a01:4f9:c012:c08a::1        (Hetzner)
#   Поки AAAA веде в паркування, ACME-виклик Let's Encrypt піде по IPv6 у чужий
#   хост, токена там не знайде — і сертификата не буде. Це не «щось не так із
#   Caddy», це саме AAAA.
#   Лікується одним із двох: видалити AAAA для апекса й www, або переставити
#   його на 2a01:4f9:c012:c08a::1.
#   Перевірка перед запуском:
#     dig +short AAAA allservices.one      # має бути порожньо або 2a01:4f9:...
#     dig +short AAAA www.allservices.one  # те саме
#   Чіпати в DNS ТІЛЬКИ AAAA. MX (mail.imena.com.ua) — робоча пошта домену,
#   TXT google-site-verification — підтвердження власності в Search Console.
#
# Перед підняттям:
#   docker compose run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile
#   docker compose up -d caddy
#
# Поки експериментуєте — розкоментуйте staging, щоб не спалити ліміт
# Let's Encrypt (5 невдач на домен за годину):
# {
# 	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
# }
# ─────────────────────────────────────────────────────────────────────────────

allservices.one, www.allservices.one {
	root * /srv/site
	encode zstd gzip

	# ── Старі шляхи закритого Odoo-каталогу → 410 Gone ───────────────────
	# Чому 410, а не 301: ресурс не переїхав, він закритий, і цілі для
	# редиректу не існує. 301 у нікуди — це або петля, або 404 на другому
	# кроці. 410 прямо каже краулеру «сторінки більше не буде», і Google із
	# Bing викидають URL з індексу швидше, ніж по 404, не тримаючи їх
	# місяцями як «soft 404». Це важливо саме тут: 84,6% трафіку старого
	# сайту були боти, і домен успадковує десятки тисяч мертвих URL.
	#
	# Перелік префіксів — з archive-allservices-2026-08-18/meta/top-2000-urls.txt:
	#   /web/*            1 146 URL у топ-2000, з них /web/image — 1 136
	#                     (найважчі: /web/assets/* 142 094 і 30 635 запитів)
	#   /shop/*             834 URL, з них /shop/category — 799;
	#                     /shop/products/recently_viewed_update — 132 065 запитів
	#   /website*             3 URL + /website/translations — 64 695 запитів
	#   /website_sale/*       /website_sale/get_combination_info — 149 937 запитів,
	#                     найважчий URL усього логу
	#   /en/*             локалізовані дублі, 19 287 запитів за останні 7 діб;
	#                     у топ-2000 не потрапили, бо розмазані по багатьох URL
	#                     (джерело — meta/traffic-summary.md)
	#
	# НЕ додано свідомо: /robots.txt, /sitemap.xml і / — їх віддає новий сайт.
	# Кандидати, якщо колись знадобиться: /sitemap-1-*.xml (старі Odoo-карти),
	# /xmlrpc/* (тільки сканери), /contactus, /terms, /cookie-policy,
	# /unit-converter, /html_editor/* — вирішувати, коли буде новий контент
	# на цих іменах.
	@gone path /shop /shop/* /web/* /en/* /website* /website_sale/*
	handle @gone {
		respond "410 Gone — каталог allservices.one закрито 18.08.2026." 410
	}

	handle {
		file_server
	}

	@data path /data/* /llms.txt /modules.json
	header @data Cache-Control "public, max-age=3600"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

# ── Субдомен наявного ресурсу — НЕ ПОТРІБЕН ──────────────────────────────────
# Блок app.allservices.one прибрано 19.08.2026 разом з reverse_proxy на
# 127.0.0.1:8080: переносити нема чого, старий стек не існує.
#
# Хвости в DNS, які варто прибрати:
#   monitor.allservices.one  A → 65.21.189.197  (Grafana закритого проєкту)
#   gitlab.allservices.one   A → 65.21.189.197  (GitLab, compose-файл видалено)
# Обидва зараз мертві. Сертификатів Caddy на них брати не буде — він керує
# тільки тими іменами, що є в адресах блоків вище, — тож запити з такими Host
# просто впадуть у типовий 404. Тобто це не блокер, а прибирання: приберіть
# A-записи, щоб імена не висіли.
#
# Якщо записи вирішено лишити й хочеться явної відповіді — розкоментувати:
# monitor.allservices.one, gitlab.allservices.one {
# 	respond "410 Gone" 410
# }

# ── Локальна перевірка без DNS і без сертификата ─────────────────────────────
# Розкоментувати, щоб глянути сайт по http://IP:8081/ до правки AAAA.
# Це єдиний спосіб побачити сайт, поки апекс не готовий.
# :8081 {
# 	root * /srv/site
# 	file_server
# }
