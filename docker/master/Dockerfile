# Образ серії `master` із ДАТОВАНОГО нічного .deb з nightly.odoo.com.
#
# Навіщо взагалі: гілки 20.0 не існує до кейноуту 24.09.2026, а перевіряти
# конвейєр на серії, якої немає, треба до того дня, не в той день. `master` —
# це той самий Odoo, який 24.09 стане 20.0 (нічні збірки зараз версіоновані як
# 19.5a1), тому це найближче до 20.0, що взагалі можна поставити сьогодні.
#
# Ключ серії — `master`, а НЕ `20.0`. Це не педантизм: коли з'явиться справжня
# гілка 20.0, її прогони мусять лягти в окрему серію, інакше ми змішаємо
# «модуль працює на 20.0» з «модуль працював на передрелізному майстері» —
# і саме та цифра, за якою ми хочемо бути першими, стане нецитованою.
#
# Чому FROM odoo:19.0, а не debian: усі системні залежності, wkhtmltopdf і
# postgresql-client уже стоять і однакові з тими, на яких ідуть решта серій.
# Різниця між серіями тоді — рівно код Odoo, а не ще й склад ОС.
#
# Тег образу мусить містити ДАТУ .deb: master рухається щодня, і «прогін на
# master» без дати — твердження ні про що.
ARG BASE=odoo:19.0
FROM ${BASE}
ARG DEB
ARG DEB_URL
USER root
COPY ${DEB} /tmp/odoo-master.deb
# `apt install ./file.deb` (не dpkg -i): apt сам дотягне залежності, які майстер
# оголосив і яких у базовому образі ще немає. Якщо чогось у bookworm немає —
# збірка ПАДАЄ тут, і це правильно: краще дізнатися 21.08, ніж 24.09.
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends /tmp/odoo-master.deb; \
    rm -rf /var/lib/apt/lists/* /tmp/odoo-master.deb; \
    python3 -c 'import odoo; print("odoo", odoo.release.version)'
LABEL modidx.deb="${DEB}" modidx.deb_url="${DEB_URL}"
USER odoo
